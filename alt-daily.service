# alt-daily.service — Dallas CT 7 PM daily orchestrator
# Runs: open (freeze slate) + T-5 runner until all games closed
# Telegram picks labeled "ALT Method" at close.
#
# Install:
#   sudo cp alt-daily.service alt-daily.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now alt-daily.timer
#
# Logs: journalctl -u alt-daily.service -f
#       or tail -f runner.log  (if you keep file logging)

[Unit]
Description=ALT Method Daily — Open freeze + T-5 runner (Dallas CT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ---- EDIT THESE 3 LINES to match your machine ----
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/alt-line-clv
ExecStart=/usr/bin/python3 /home/YOUR_USER/alt-line-clv/alt_daily.py
# --------------------------------------------------
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
# Keep the process alive all evening — it exits itself when slate is done
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
